/ios
/android
# Metro
.metro-health-check*
# Native build artifacts (万一 prebuild した場合)
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# ===== TypeScript =====
*.tsbuildinfo

# ===== Environment variables / Secrets =====
# 実際の値は絶対にコミットしない。雛形の .env.example だけ管理する
.env
.env.*
!.env.example
*.pem

# ===== Cloudflare Workers (workers/) =====
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example
workers/node_modules/
workers/dist/

# ===== Supabase =====
# マイグレーション(supabase/migrations)や config.toml は管理対象
supabase/.temp/
supabase/.branches/
supabase/.env
supabase/.env.*
supabase/seed.local.sql

# ===== Tests / Coverage =====
coverage/
.nyc_output/
test-results/
playwright-report/
# Maestro のスクリーンショット・録画
.maestro/screenshots/
.maestro/recordings/

# ===== Logs =====
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===== Editor / IDE =====
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# ===== OS (Windows / WSL / macOS) =====
.DS_Store
Thumbs.db
desktop.ini
# WSL から /mnt/c を触ったときに付くことがある
*:Zone.Identifier

# ===== Claude Code =====
# 個人用の設定・ローカルメモリはコミットしない。共有したい CLAUDE.md は管理対象
.claude/settings.local.json
CLAUDE.local.md

